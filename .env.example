# Server-side only. Fill locally; never paste keys into chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/secondlook.db
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=90
MAX_WINDOW_SECONDS=8
MAX_FRAMES_PER_CALL=24
MAX_MODEL_CALLS_PER_JOB=3
APP_BUDGET_USD=15
JOB_BUDGET_USD=1
TRACKER_BACKEND=manual
ENABLE_JEV=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
ALLOW_REPLAY=false
# anthropic (default) or synthetic. Synthetic is a labelled plumbing fixture, never a fallback.
EVIDENCE_PROVIDER=anthropic
MIN_VIDEO_SECONDS=6
MIN_WINDOW_SECONDS=6
PRICE_INPUT_PER_MTOK=2
PRICE_OUTPUT_PER_MTOK=10
MAX_OUTPUT_TOKENS=1500
