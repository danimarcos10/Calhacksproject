# Server-side only. Fill locally; never paste keys into chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/secondlook.db
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=90
MAX_WINDOW_SECONDS=8
MAX_FRAMES_PER_CALL=24
MAX_MODEL_CALLS_PER_JOB=3
APP_BUDGET_USD=15
JOB_BUDGET_USD=1
TRACKER_BACKEND=manual
ENABLE_JEV=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
ALLOW_REPLAY=false
# anthropic (default) or synthetic. Synthetic is a labelled plumbing fixture, never a fallback.
EVIDENCE_PROVIDER=anthropic
MIN_VIDEO_SECONDS=6
MIN_WINDOW_SECONDS=6
PRICE_INPUT_PER_MTOK=2
PRICE_OUTPUT_PER_MTOK=10
MAX_OUTPUT_TOKENS=4000
# Public program lists and coaches pages. Coupon APIFY_CAL_HACKS. Never commit the token.
APIFY_TOKEN=
# Coach email. Create a Gmail app password. Leave MAIL_LIVE false so every send goes to MAIL_TEST_TO.
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM_NAME=SecondLook
MAIL_TEST_TO=
MAIL_LIVE=false
OUTREACH_LIVE_CAP=5
# Convex coach review. scripts/convex_setup.py fills CONVEX_URL and CONVEX_WORKER_SECRET
# and copies the secret to the deployment's WORKER_SECRET. Leave both blank to run without the worker bridge.
CONVEX_URL=
CONVEX_WORKER_SECRET=
CONVEX_WORKER_ID=laptop-worker
CONVEX_POLL_SECONDS=2
